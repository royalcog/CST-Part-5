// the second stretch of the climb, built from the map below: one string per 40px row, 39 across (= the tower's 1560px).
// it wraps: the left edge carries on from the right edge.
//  =  ledge                 S  ledge + where you start (coming up from rm_tower)
//  C  crumbling ledge       (shakes when you stand on it, drops, comes back)
//  O  ring of white dots    Q  bigger ring, spinning the other way
//  F  fish swim along the ledge just below this
//  R  falling rubble around here
//  W  wind gusts push you sideways
//  .  nothing
// obstacles get harder the higher they are (scr_plat_difficulty): the bottom stretch has none, the top is the worst.
// reach the ledge in the top row and you're through to rm_tower_top. fall off the bottom and you're back in rm_tower.
// (to paint this room by hand instead, delete the scr_plat_build_tower line)
var _map = [
    ".......................................",   // 0
    ".................======................",   // 40
    ".......................................",   // 80
    ".........................CCCC..........",   // 120
    ".......................................",   // 160
    "...............................=====...",   // 200
    "...O..................................R",   // 240
    "===...................................=",   // 280
    ".......................................",   // 320
    ".....=====.............................",   // 360
    "................F......................",   // 400
    "...........==========..................",   // 440
    ".......................................",   // 480
    "......................===..............",   // 520
    ".......................................",   // 560
    "...........................===.........",   // 600
    ".................................Q.....",   // 640
    "................................===....",   // 680
    ".......................................",   // 720
    ".................................CCCCC.",   // 760
    ".......................................",   // 800
    "............................===........",   // 840
    ".......................................",   // 880
    "......................=====............",   // 920
    "...............F.......................",   // 960
    "..........==========...................",   // 1000
    "...O...................................",   // 1040
    ".....CCC...............................",   // 1080
    "R......................................",   // 1120
    "===....................................",   // 1160
    ".......................................",   // 1200
    ".................................====..",   // 1240
    ".....W.................................",   // 1280
    "..........................=====........",   // 1320
    ".......................................",   // 1360
    "........................CCC............",   // 1400
    "................................Q......",   // 1440
    "............................====.......",   // 1480
    ".......................................",   // 1520
    ".................................=====.",   // 1560
    ".......................................",   // 1600
    ".=====.................................",   // 1640
    "............F..........................",   // 1680
    ".......==========......................",   // 1720
    ".......................................",   // 1760
    "...................===.................",   // 1800
    "........................R....O.........",   // 1840
    "........................=====..........",   // 1880
    "..........W............................",   // 1920
    "..............................====.....",   // 1960
    ".......................................",   // 2000
    "...................................CCC.",   // 2040
    ".......................................",   // 2080
    "==....................................=",   // 2120
    ".......................................",   // 2160
    ".................................====..",   // 2200
    "...........................Q...........",   // 2240
    "............................===........",   // 2280
    ".......................................",   // 2320
    "......................CCCCC............",   // 2360
    "................F......................",   // 2400
    "...........==========..................",   // 2440
    ".......................................",   // 2480
    "......====.............................",   // 2520
    ".......................................",   // 2560
    "====..................................=",   // 2600
    ".......................................",   // 2640
    "..................................===..",   // 2680
    ".......................................",   // 2720
    ".............................====......",   // 2760
    ".......................................",   // 2800
    ".......................====............",   // 2840
    ".......................................",   // 2880
    ".................==S==.................",   // 2920
    "......................................."    // 2960
];
scr_plat_build_tower(_map, false);   // tiles come from the room editor now; the map just places the start + obstacles

// the Titan's tower behind everything: just in front of the Background layer (wherever that is), behind the tiles
if (!layer_exists("TowerBG"))
{
    var _bg = layer_exists("Background") ? layer_get_depth(layer_get_id("Background")) : 500;
    layer_create(_bg - 10, "TowerBG");
}
if (!instance_exists(obj_titan_tower))
{
    with (instance_create_layer(0, 0, "TowerBG", obj_titan_tower))
    {
        base_bottom_y = room_height;
        pillar_w      = 480;
        parallax      = 0.5;
        tower_shade   = 0.6;
    }
}

if (!instance_exists(obj_plat_controller)) instance_create_depth(0, 0, 0, obj_plat_controller);