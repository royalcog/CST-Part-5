// x = the fountain's centre, y = where its bottom sits
scale        = 2;
top_y        = 0;     // the column runs up to here

scroll_spd   = 0.6;   // texture rising, px per frame
scroll_spd2  = 1.0;   // second layer, a bit faster
layer2_alpha = 0.6;

hue     = 150;        // 0-255
hue_spd = 0.15;       // 0 = no colour cycling
hue_gap = 25;         // second layer's hue offset
sat     = 90;         // 0 = pure grey/white

scroll  = 0;
scroll2 = 0;
surf    = -1;